{
  "name": "White Wolf",
  "type": "dark",
  "colors": {
    "editor.background": "#161b22",
    "editor.foreground": "#c8cdd2",
    "editorLineNumber.foreground": "#4a5560",
    "editorLineNumber.activeForeground": "#8b9aab",
    "editorCursor.foreground": "#c23b3b",
    "editor.selectionBackground": "#c8cdd233",
    "editor.inactiveSelectionBackground": "#1a151580",
    "editorIndentGuide.background1": "#1c2128",
    "editorIndentGuide.activeBackground1": "#3a4550",
    "editorHoverWidget.background": "#161b22",
    "editorHoverWidget.foreground": "#c8cdd2",

    "activityBar.background": "#0d1117",
    "activityBar.foreground": "#d4a373",
    "activityBar.activeBorder": "#c23b3b",
    "activityBarBadge.background": "#c23b3b",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#161b22",
    "sideBar.foreground": "#c8cdd2",
    "sideBarTitle.foreground": "#d4a373",
    "sideBarSectionHeader.background": "#0d1117",
    "sideBarSectionHeader.foreground": "#d4a373",

    "statusBar.background": "#0d1117",
    "statusBar.foreground": "#d4a373",
    "statusBar.noFolderBackground": "#050608",
    "statusBarItem.remoteBackground": "#c23b3b",

    "list.activeSelectionBackground": "#5c2428",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#3a1c1c",
    "list.focusBackground": "#5c2428",
    "list.focusOutline": "#c23b3b",
    "list.hoverBackground": "#2a1a1c",

    "titleBar.activeBackground": "#0d1117",
    "titleBar.activeForeground": "#c8cdd2",
    "titleBar.inactiveBackground": "#0d1117",
    "titleBar.inactiveForeground": "#4a5560",

    "tab.activeBackground": "#0d1117",
    "tab.activeForeground": "#d4a373",
    "tab.inactiveBackground": "#0d1117",
    "tab.inactiveForeground": "#c8cdd2",
    "tab.border": "#0d1117",
    "tab.activeBorder": "#c23b3b",
    "tab.activeBorderTop": "#c23b3b",
    "tab.unfocusedActiveForeground": "#d4a373",
    "tab.unfocusedInactiveForeground": "#6b7280",
    "editorGroupHeader.tabsBackground": "#0d1117",
    "editorGroupHeader.tabsBorder": "#0d1117",

    "focusBorder": "#d4a373",
    "input.border": "#3a4550",
    "input.background": "#0d1117",
    "input.foreground": "#d4a373",
    "input.placeholderForeground": "#8b9aab",
    "inputOption.activeBorder": "#d4a373",
    "inputOption.activeBackground": "#c23b3b",

    "panel.background": "#161b22",
    "panel.border": "#1c2128",

    "terminal.background": "#161b22",
    "terminal.foreground": "#c8cdd2",

    "button.background": "#c23b3b",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#a32f2f",
    "button.secondaryBackground": "#161b22",
    "button.secondaryForeground": "#d4a373",
    "button.secondaryHoverBackground": "#2a1a1c",

    "textLink.foreground": "#d4a373",
    "textLink.activeForeground": "#c23b3b"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5c6b7a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#a3b18a"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#c23b3b"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#7aa2d6"
      }
    },
    {
      "scope": ["variable", "entity.name.variable"],
      "settings": {
        "foreground": "#c8cdd2"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#d4a373"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": {
        "foreground": "#e0aaff"
      }
    }
  ]
}
